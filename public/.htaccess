<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + WWW
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.starallianceaviation.com%{REQUEST_URI} [L,R=301]

  # Old unwanted URLs → Redirect to Home
  Redirect 301 /team-member/ /
  Redirect 301 /testimonial/ /
  Redirect 301 /portfolio-category/ /
  Redirect 301 /service-category/ /
  Redirect 301 /category/blog/ /
  Redirect 301 /category/blog/feed/ /

  # Existing files/folders should load normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React SPA fallback only for valid frontend routes
  RewriteRule . /index.html [L]
</IfModule>

ErrorDocument 404 /404.html