# ===============================
# 🔥 FINAL CLEAN HTACCESS
# ===============================

RewriteEngine On

# ===============================
# ❌ FORCE 410 (OLD WORDPRESS URLS)
# ===============================
RewriteRule ^(2019|2020|portfolio|tag|testimonial|portfolio-category|service-category|feed)(/|$) - [G,L]
RewriteRule ^(project-style-1|make-appointment-2|our-history)(/|$) - [G,L]

# ===============================
# ✅ FORCE HTTPS + NON-WWW
# ===============================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.starallianceaviation\.com [NC]
RewriteRule ^(.*)$ https://starallianceaviation.com/$1 [R=301,L]

# ===============================
# ✅ REACT ROUTING
# ===============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]