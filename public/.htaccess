RewriteEngine On

# ✅ FORCE HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://starallianceaviation.com/$1 [R=301,L]

# ✅ REMOVE WWW
RewriteCond %{HTTP_HOST} ^www\.starallianceaviation\.com [NC]
RewriteRule ^(.*)$ https://starallianceaviation.com/$1 [R=301,L]

# ✅ REMOVE INDEX.HTML
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

# ✅ REDIRECT WORDPRESS URLS
RewriteRule ^category/(.*)$ / [R=301,L]
RewriteRule ^tag/(.*)$ / [R=301,L]

RewriteCond %{QUERY_STRING} ^p=([0-9]+)$
RewriteRule ^$ /? [R=301,L]

# ✅ OPTIONAL: REDIRECT OLD PAGES (CUSTOM)
# Example:
# RewriteRule ^old-course$ /courses [R=301,L]

# ✅ REACT ROUTING FIX (VERY IMPORTANT)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ===============================
# 🔥 PERMANENT DELETE (410) – ALL OLD WORDPRESS URLS
# ===============================

RewriteEngine On

# ❌ REMOVE ALL DATE-BASED BLOG URLs (2019, 2020)
RewriteRule ^2019/.*$ - [G,L]
RewriteRule ^2020/.*$ - [G,L]

# ❌ REMOVE PORTFOLIO + PROJECT
RewriteRule ^portfolio/.*$ - [G,L]
Redirect 410 /portfolio/
Redirect 410 /project-style-1/

# ❌ REMOVE TAG / CATEGORY / SERVICE
RewriteRule ^tag/.*$ - [G,L]
RewriteRule ^portfolio-category/.*$ - [G,L]
RewriteRule ^service-category/.*$ - [G,L]

# ❌ REMOVE TESTIMONIAL (ALL TYPES)
RewriteRule ^testimonial/.*$ - [G,L]

# ❌ REMOVE SPECIFIC PAGES
Redirect 410 /make-appointment-2/
Redirect 410 /our-history/

# ❌ REMOVE FEED
Redirect 410 /feed/


# ✅ REMOVE SPECIFIC JUNK PAGES (410 = PERMANENT DELETE)
Redirect 410 /portfolio/
Redirect 410 /project-style-1/
Redirect 410 /make-appointment-2/
Redirect 410 /our-history/

# ✅ REMOVE TAGS / CATEGORIES / SERVICES
RewriteRule ^tag/.*$ - [G,L]
RewriteRule ^portfolio-category/.*$ - [G,L]
RewriteRule ^service-category/.*$ - [G,L]

# ✅ REMOVE TESTIMONIAL URLs
RewriteRule ^testimonial/.*$ - [G,L]

# ✅ REMOVE FEED
Redirect 410 /feed/