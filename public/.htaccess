RewriteEngine On

Redirect 302 /check-htaccess https://google.com

# ===============================
# ✅ FORCE HTTPS + NON-WWW
# ===============================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.starallianceaviation\.com [NC]
RewriteRule ^(.*)$ https://starallianceaviation.com/$1 [R=301,L]

# ===============================
# ❌ PERMANENT DELETE (410) OLD WORDPRESS URLS
# ===============================

# Date-based blogs
RewriteRule ^(2019|2020)/.*$ - [G,L]

# Portfolio & project
RewriteRule ^portfolio/.*$ - [G,L]
Redirect 410 /portfolio/
Redirect 410 /project-style-1/

# Tags / categories / services
RewriteRule ^tag/.*$ - [G,L]
RewriteRule ^portfolio-category/.*$ - [G,L]
RewriteRule ^service-category/.*$ - [G,L]

# Testimonials
RewriteRule ^testimonial/.*$ - [G,L]

# Specific junk pages
Redirect 410 /make-appointment-2/
Redirect 410 /our-history/

# Feed
Redirect 410 /feed/

# ===============================
# ✅ REACT ROUTING (ONLY ONCE)
# ===============================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]